{
  "id": null,
  "uid": "app-performance",
  "title": "FramerClone — Application Performance",
  "tags": ["framerclone", "app", "performance"],
  "timezone": "browser",
  "schemaVersion": 36,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "App Uptime",
      "type": "stat",
      "targets": [
        {
          "expr": "up{job=\"framerclone-blue\"}",
          "legendFormat": "Blue",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "title": "Scrape Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "prometheus_http_request_duration_seconds{handler=\"/api/metrics\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 6, "y": 0 }
    },
    {
      "id": 3,
      "title": "Go Memory Allocated",
      "type": "timeseries",
      "targets": [
        {
          "expr": "go_memstats_alloc_bytes{job=\"framerclone-blue\"}",
          "legendFormat": "Allocated",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "bytes" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 }
    },
    {
      "id": 4,
      "title": "Go GC Duration",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(go_gc_duration_seconds_sum[5m]) / rate(go_gc_duration_seconds_count[5m])",
          "legendFormat": "GC Pause",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 }
    },
    {
      "id": 5,
      "title": "Goroutines",
      "type": "timeseries",
      "targets": [
        {
          "expr": "go_goroutines{job=\"framerclone-blue\"}",
          "legendFormat": "Goroutines",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 }
    },
    {
      "id": 6,
      "title": "User Growth (per day)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(framerclone_users_total[1d])",
          "legendFormat": "Users/day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 }
    },
    {
      "id": 7,
      "title": "Project Growth (per day)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(framerclone_projects_total[1d])",
          "legendFormat": "Projects/day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 }
    },
    {
      "id": 8,
      "title": "Sync Activity (per hour)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(framerclone_syncs_total[1h])",
          "legendFormat": "Syncs/hour",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 }
    }
  ]
}
